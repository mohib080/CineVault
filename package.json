{
  "name": "cinevault",
  "version": "1.0.0",
  "description": "Personal Movie Diary & Tracker with Granular Privacy",
  "main": "server/dist/index.js",
  "scripts": {
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:server && npm run build:client",
    "ingest:imdb": "cd server && npm run ingest:imdb",
    "ingest:imdb:all": "cd server && npm run ingest:imdb:all",
    "test:privacy": "cd server && npm test",
    "start": "cd server && npm start"
  },
  "keywords": [
    "cinevault",
    "movies",
    "diary",
    "letterboxd",
    "privacy",
    "unlisted",
    "tmdb",
    "postgresql"
  ],
  "author": "CineVault Team",
  "license": "MIT"
}
