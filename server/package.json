{
  "name": "cinevault-server",
  "version": "1.0.0",
  "description": "CineVault Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx tests/privacy.test.ts && tsx tests/features.test.ts",
